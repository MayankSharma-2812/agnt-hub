{
  "name": "agent-hub",
  "version": "0.1.0",
  "private": true,
  "description": "Collaborative multi-agent coordination server and Kanban dashboard for autonomous AI coding agents (MCP + Antigravity + Git Worktrees)",
  "author": "Mayank Sharma",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/MayankSharma-2812/agnt-hub.git"
  },
  "bugs": {
    "url": "https://github.com/MayankSharma-2812/agnt-hub/issues"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "ai-agents",
    "multi-agent",
    "antigravity",
    "kanban",
    "worktree",
    "developer-tools"
  ],
  "scripts": {
    "dev": "pnpm --filter @agent-hub/hub dev",
    "build": "pnpm --recursive run build",
    "lint": "eslint .",
    "typecheck": "tsc --build",
    "test": "vitest run",
    "format": "prettier --write ."
  },
  "devDependencies": {
    "@eslint/js": "^9.14.0",
    "eslint": "^9.14.0",
    "prettier": "^3.3.3",
    "tsx": "^4.23.15",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.13.0",
    "vitest": "^2.1.4"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
