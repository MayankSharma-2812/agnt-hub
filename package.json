{
  "name": "agent-hub",
  "version": "0.1.0",
  "private": true,
  "description": "Multi-agent coordination hub for Antigravity AI agents",
  "scripts": {
    "dev": "pnpm --filter @agent-hub/hub dev",
    "build": "pnpm --recursive run build",
    "lint": "eslint .",
    "typecheck": "tsc --build",
    "test": "vitest run",
    "format": "prettier --write ."
  },
  "devDependencies": {
    "@eslint/js": "^9.14.0",
    "eslint": "^9.14.0",
    "prettier": "^3.3.3",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.13.0",
    "vitest": "^2.1.4"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
